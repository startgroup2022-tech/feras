# Safir Holding 2027 — staging environment template.
#
# Copy to /etc/safir/staging.env (mode 600, owned by the service user) and fill
# in the real values. NEVER commit the filled file, and never reuse production
# credentials here. This template contains no real secrets.

# ---- application ----
# NOTE: APP_ENV=staging. The production-only SECRET_KEY guard does not run for
# "staging", so the strong key below is enforced operationally, not by code.
# Use "production" instead if you want that guard AND are willing to lose the
# Swagger UI entirely.
APP_ENV=staging
DEBUG=false

# ---- database (dedicated staging instance; never production) ----
DATABASE_URL=postgresql+psycopg://safir_staging:REPLACE_ME@127.0.0.1:5432/safir_staging
DB_ECHO=false

# ---- security ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_64_BYTES_OF_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS (only needed if the frontend is served from a different origin) ----
CORS_ORIGINS=https://staging.example.com

# ---- rate limiting (in-process; keep exactly one uvicorn worker) ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# ---- uploads (persistent volume; survives redeploys) ----
UPLOAD_DIR=/var/lib/safir/uploads

# ---- AI (deterministic offline provider for staging) ----
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# ---- docs ----
# Swagger is additionally restricted to authorized users at the reverse proxy.
DOCS_ENABLED=true
