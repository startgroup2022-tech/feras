# Safir Holding 2027 — staging environment template.
#
# Copy to /etc/safir/staging.env (mode 600, owned by the service user) and fill
# in the real values. NEVER commit the filled file, and never reuse production
# credentials here. This template contains no real secrets.

# ---- application ----
# NOTE: APP_ENV=staging. The production-only SECRET_KEY guard does not run for
# "staging", so the strong key below is enforced operationally, not by code.
# Use "production" instead if you want that guard AND are willing to lose the
# Swagger UI entirely.
APP_ENV=staging
DEBUG=false

# ---- database (dedicated staging instance; never production) ----
DATABASE_URL=postgresql+psycopg://safir_staging:REPLACE_ME@127.0.0.1:5432/safir_staging
DB_ECHO=false

# ---- security ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_64_BYTES_OF_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS (only needed if the frontend is served from a different origin) ----
CORS_ORIGINS=https://staging.example.com

# ---- rate limiting (in-process; keep exactly one uvicorn worker) ----
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
# Public website submissions (per IP, sliding window). Separate from the login
# limiter so marketing traffic cannot lock out sign-in.
PUBLIC_RATE_LIMIT=20
PUBLIC_RATE_WINDOW_SECONDS=600
PUBLIC_MAX_ATTACHMENTS=5

# ---- public website ----
# Absolute origin used for canonical URLs, hreflang alternates and the sitemap.
# Leave blank in development; set it in staging/production.
WEBSITE_BASE_URL=https://staging.example.com
# Production layout: the public website owns the root and the internal platform
# is served under PLATFORM_PATH with X-Robots-Tag: noindex. Set to true here.
SPLIT_PUBLIC_SITE=true
PLATFORM_PATH=/platform

# ---- uploads (persistent volume; survives redeploys) ----
UPLOAD_DIR=/var/lib/safir/uploads

# ---- AI ----
# "none"  -> deterministic offline provider (default; free, no network).
# "openrouter" -> free-model-only OpenRouter; requires OPENROUTER_API_KEY.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# ---- OpenRouter (used when AI_PROVIDER=openrouter) ----
# The key lives only in the server environment; it is never sent to the browser
# and never logged. Leave blank to keep the deterministic provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" only ever routes to zero-cost models; the provider still
# verifies the effective price and refuses anything billable.
OPENROUTER_MODEL=openrouter/free
# Ordered fallbacks, all verified free at request time. Empty = no fallback.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_FREE_MODELS=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Safir Holding 2027
# Refuse a completion whose reported cost exceeds this (USD). 0 = reject any
# nonzero cost.
OPENROUTER_MAX_COST_USD=0.0

# Per-user AI rate limit and group-wide daily ceiling (app-level, provider-
# independent). Reaching the daily ceiling degrades to the deterministic
# provider rather than failing.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_DAILY_REQUEST_LIMIT=2000

# ---- docs ----
# Swagger is additionally restricted to authorized users at the reverse proxy.
DOCS_ENABLED=true
